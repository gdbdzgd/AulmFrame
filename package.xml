<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>AlumFrame</name>
  <description>Parametric aluminum extrusion frame generator: automatic BOM with drilling/tapping notes, TechDraw A2 shop drawings with dimensions, and a bilingual (Chinese/English) user interface.</description>
  <version>2.2.1</version>
  <date>2026-09-26</date>
  <maintainer email="gdbdzgd@gmail.com">gdbdzgd</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="release">https://github.com/gdbdzgd/AulmFrame</url>
  <url type="bugtracker">https://github.com/gdbdzgd/AulmFrame/issues</url>
  <url type="readme">https://raw.githubusercontent.com/gdbdzgd/AulmFrame/main/README_EN.md</url>
  <icon>freecad/AlumFrame/icons/frame_xpm.xpm</icon>
  <freecadmin>1.1.0</freecadmin>
  <pythonmin>3.10</pythonmin>

  <content>
    <workbench>
      <classname>AlumFrameWorkbench</classname>
      <subdirectory>./</subdirectory>
      <tag>frame</tag>
      <tag>aluminum</tag>
      <depend type="internal">part</depend>
      <depend type="internal">sketcher</depend>
      <depend type="internal">spreadsheet</depend>
      <depend type="internal">techdraw</depend>
    </workbench>
  </content>

</package>
